# MangroveWatch Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,https://mangrovewatch.vercel.app

# Mock data mode - set to true to use sample GeoJSON data without Earth Engine
USE_MOCK_DATA=true

# Google Earth Engine (required when USE_MOCK_DATA=false)
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_FILE=

# Twilio SMS (optional - mocked when not set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBERS=

# SMTP Email (optional - mocked when not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENTS=

# Auth
OFFICER_TOKEN=mangrovewatch-officer-secret-2024

# Carbon estimation
CARBON_EMISSION_FACTOR=450.0
CARBON_CREDIT_PRICE_USD=25.0

# Upload directory
UPLOAD_DIR=./uploads
